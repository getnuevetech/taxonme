# PostgreSQL connection
DATABASE_URL="postgresql://taxonme:taxonme_dev_password@localhost:5432/taxonme?schema=public"

# Optional: override the session signing secret (otherwise auto-generated and stored in the settings table)
# AUTH_SECRET=

# Optional for local development: initial super-admin credentials used by `prisma db seed`
# Production seeding requires SEED_ADMIN_PASSWORD to be set explicitly.
# SEED_ADMIN_EMAIL=admin@mytaxonme.com
# SEED_ADMIN_PASSWORD=
