# PostgreSQL connection
DATABASE_URL="postgresql://taxonme:taxonme_dev_password@localhost:5432/taxonme?schema=public"

# Required in production: session signing secret
# AUTH_SECRET=

# Required for POST /api/cron/maintenance
# CRON_SECRET=

# Optional production override for manual billing of paid plans (normally disabled)
# ALLOW_MANUAL_BILLING=false

# Optional for local development: initial super-admin credentials used by `prisma db seed`
# Production seeding requires SEED_ADMIN_PASSWORD to be set explicitly.
# SEED_ADMIN_EMAIL=admin@mytaxonme.com
# SEED_ADMIN_PASSWORD=

# Optional one-time maintenance override:
# By default, released v3 prompt bodies are immutable and seed preserves existing text.
# Set only when intentionally replacing released prompt bodies from code.
# RESEED_AI_PROMPTS=false

# AI provider API keys are intentionally not configured here.
# Configure them in Admin -> AI providers so each provider carries data-retention,
# region, cost-tier, timeout, structured-output, and context-window metadata.
