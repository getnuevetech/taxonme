# Database connection (SQLite for development; use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Optional: override the session signing secret (otherwise auto-generated and stored in the settings table)
# AUTH_SECRET=

# Optional: initial super-admin credentials used by `npm run db:seed`
# SEED_ADMIN_EMAIL=admin@mytaxonme.com
# SEED_ADMIN_PASSWORD=ChangeMe!2026
