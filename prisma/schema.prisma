// TaxOnMe data model — PostgreSQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Platform configuration (everything admin-manageable) ----------

model Setting {
  key         String  @id
  value       String
  type        String  @default("text") // text | number | boolean | json | secret
  group       String  @default("general")
  label       String  @default("")
  description String  @default("")
  updatedAt   DateTime @updatedAt
}

model FeatureDef {
  key         String        @id
  name        String
  description String        @default("")
  category    String        @default("general")
  sortOrder   Int           @default(0)
  planFeatures PlanFeature[]
}

model SubscriptionPlan {
  id                String         @id @default(cuid())
  key               String         @unique
  name              String
  audience          String         @default("customer") // customer | consultant
  description       String         @default("")
  priceMonthlyCents Int            @default(0)
  priceYearlyCents  Int            @default(0)
  badge             String         @default("")
  sortOrder         Int            @default(0)
  isActive          Boolean        @default(true)
  features          PlanFeature[]
  subscriptions     Subscription[]
  transactions      PaymentTransaction[]
  discounts         PlanDiscount[]
}

// Admin-managed subscription discounts: general (every customer sees the sale
// price) or targeted at specific people by email. Time-bound and stackable
// per plan (the best active discount wins).
model PlanDiscount {
  id             String    @id @default(cuid())
  planId         String
  name           String // shown to customers, e.g. "Launch sale"
  percentOff     Int       @default(0) // 1–100; used when > 0
  amountOffCents Int       @default(0) // fixed discount; used when percentOff = 0
  audience       String    @default("all") // all | specific
  emailsJson     String    @default("[]") // JSON array of emails when audience = specific
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PlanFeature {
  id         String           @id @default(cuid())
  planId     String
  featureKey String
  enabled    Boolean          @default(false)
  limitValue Int? // null = unlimited when enabled
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature    FeatureDef       @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model PaymentGatewayConfig {
  id        String   @id @default(cuid())
  name      String
  kind      String // stripe | paypal | manual | custom
  mode      String   @default("test") // test | live
  isActive  Boolean  @default(false)
  isDefault Boolean  @default(false)
  configJson String  @default("{}") // gateway-specific keys/secrets/urls
  updatedAt DateTime @updatedAt
}

model AiProvider {
  id            String         @id @default(cuid())
  name          String
  kind          String // openai_compatible | anthropic | google
  baseUrl       String         @default("")
  apiKey        String         @default("")
  model         String
  maxTokens     Int            @default(4096)
  temperature   Float          @default(0.2)
  supportsVision Boolean       @default(false)
  isEnabled     Boolean        @default(true)
  notes         String         @default("")
  dataRetentionProfile String  @default("unreviewed")
  regionProfile String         @default("unreviewed")
  costTier      String         @default("medium") // high | medium | low
  timeoutMs     Int            @default(90000)
  supportsStructuredOutput Boolean @default(false)
  maxContextTokens Int        @default(0)
  createdAt     DateTime       @default(now())
  steps         PipelineStep[]
  stepResults   AnalysisStepResult[]
}

model AiPrompt {
  id             String   @id @default(cuid())
  promptId       String   @unique
  kind           String // global | responsibility | overlay | schema
  responsibility String   @default("")
  stageKey       String   @default("")
  version        String   @default("3.0")
  schemaVersion  String   @default("3.0")
  title          String   @default("")
  body           String
  bodyHash       String   @default("")
  isReleased     Boolean  @default(true)
  releasedAt     DateTime?
  supersedesPromptId String @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  changes        AiPromptChange[]
}

model AiPromptChange {
  id             String   @id @default(cuid())
  promptRecordId String
  promptId       String
  fromHash       String   @default("")
  toHash         String   @default("")
  changeReason   String   @default("")
  createdAt      DateTime @default(now())
  prompt         AiPrompt @relation(fields: [promptRecordId], references: [id], onDelete: Cascade)
}

model PipelineStage {
  key           String         @id // summary | goal | document | situation | presenter | qa | notice | letter
  name          String
  description   String         @default("")
  isEnabled     Boolean        @default(true)
  mergeStrategy String         @default("consensus") // consensus | first | presenter
  version       String         @default("1.0")
  reviewerRequired Boolean     @default(false)
  sourceRequired Boolean       @default(false)
  steps         PipelineStep[]
}

model PipelineStep {
  id             String        @id @default(cuid())
  stageKey       String
  providerId     String
  role           String // fact_extractor | interpreter | skeptic | extractor_a | extractor_b | analyst | reviewer | presenter | assistant
  promptTemplate String
  sortOrder      Int           @default(0)
  isEnabled      Boolean       @default(true)
  mode           String        @default("sequential") // sequential | parallel | failover
  routeKey       String        @default("")
  promptId       String        @default("")
  promptVersion  String        @default("")
  schemaVersion  String        @default("")
  pipelineVersion String       @default("")
  isConditional  Boolean       @default(false)
  conditionsJson String        @default("[]")
  stage          PipelineStage @relation(fields: [stageKey], references: [key], onDelete: Cascade)
  provider       AiProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  id         String   @id @default(cuid())
  title      String
  sourceType String   @default("publication") // publication | form_instruction | notice_guide | irm | rule | announcement
  reference  String   @default("") // e.g. "Pub 594", "CP2000"
  url        String   @default("")
  content    String   @default("")
  tags       String   @default("") // comma separated
  taxYear    Int?
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// ---------- Users, roles, agreements ----------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String    @default("")
  passwordHash    String?
  googleId        String?   @unique
  role            String    @default("user") // super_admin | admin | user | consultant
  status          String    @default("active") // active | suspended | deleted
  firstName       String    @default("")
  lastName        String    @default("")
  address         String    @default("")
  idNumber        String    @default("") // optional, user-provided
  bio             String    @default("")
  avatarPath      String    @default("")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  adminRoleId     String?
  adminRole       AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  adminPermissions    AdminPermission[]
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  transactions        PaymentTransaction[]
  cases               Case[]
  documents           Document[]
  deadlines           Deadline[]
  letters             ResponseLetter[]
  qaThreads           QaThread[]
  formSubmissions     FormSubmission[]
  notifications       Notification[]
  agreementAcceptances AgreementAcceptance[]
  consultantProfile   ConsultantProfile?
  clientAssignments   ConsultantAssignment[] @relation("assignmentClient")
  consultantAssignments ConsultantAssignment[] @relation("assignmentConsultant")
  notices             Notice[]
  tickets             Ticket[]
  assignedTickets     Ticket[] @relation("ticketAssignee")
}

model AdminPermission {
  id         String @id @default(cuid())
  userId     String
  featureKey String // admin area key, e.g. admin.users, admin.ai, admin.payments
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
}

// Standalone role management: a role bundles a set of admin areas and can be
// assigned to any admin user. Roles are created/edited independently of users.
model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  areasJson   String   @default("[]") // JSON array of admin area keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdByAdmin Boolean   @default(false)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String   @default("")
  kind        String   @default("page") // page | blog | terms | privacy | policy | legal | agreement_user | agreement_consultant | agreement_connection
  audience    String   @default("all") // all | user | consultant | admin
  version     Int      @default(1)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  acceptances AgreementAcceptance[]
}

model AgreementAcceptance {
  id         String      @id @default(cuid())
  userId     String
  pageId     String
  version    Int
  context    String      @default("registration") // registration | consultant_signup | assignment
  acceptedAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  page       ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ---------- Billing ----------

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  planId           String
  status           String           @default("active") // active | trialing | past_due | canceled
  interval         String           @default("monthly") // monthly | yearly
  gateway          String           @default("manual")
  gatewayRef       String           @default("")
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  canceledAt       DateTime?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
}

model PaymentTransaction {
  id          String            @id @default(cuid())
  number      Int               @unique @default(autoincrement()) // shown as TXN-000123, sent to the gateway as a reference
  userId      String
  planId      String?
  amountCents Int
  currency    String            @default("USD")
  status      String            @default("pending") // pending | succeeded | failed | refunded
  gateway     String
  gatewayRef  String            @default("")
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan? @relation(fields: [planId], references: [id])
}

// ---------- Guest intake ----------

model GuestSession {
  id              String    @id @default(cuid())
  token           String    @unique
  situation       String    @default("")
  goal            String    @default("")
  email           String    @default("")
  teaserJson      String    @default("") // limited pre-registration result
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())
  documents       Document[]
  cases           Case[]
  qaThreads       QaThread[]
}

// ---------- Cases & analysis ----------

model Case {
  id             String    @id @default(cuid())
  number         Int       @unique @default(autoincrement()) // shown as TOM-000123
  userId         String?
  guestSessionId String?
  title          String
  situation      String    @default("")
  goal           String    @default("")
  status         String    @default("intake") // intake | analyzing | analyzed | needs_info | consultant_recommended | resolved | closed
  readinessScore Int       @default(0)
  // v3.2 keeps the customer's side and our side of readiness apart, so a document
  // we failed to read never reads as something the customer withheld.
  evidenceAvailableScore Int @default(0) // of what the case needs, how much has been provided
  evidenceProcessedScore Int @default(100) // of what was provided, how much we successfully read
  conflictsJson  String    @default("[]") // detected information conflicts [{topic, description, resolution}]
  closedAt       DateTime?
  closedReason   String    @default("") // completed | abandoned | manual
  closingRemarks String    @default("") // final review & closing remarks (AI or deterministic)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  documents      Document[]
  runs           AnalysisRun[]
  issues         Issue[]
  pathSteps      PathStep[]
  deadlines      Deadline[]
  letters        ResponseLetter[]
  notices        Notice[]
  assignments    ConsultantAssignment[]
  comments       CaseComment[]
  clarifyMessages CaseClarifyMessage[]
  analysisVersions CaseAnalysisVersion[]
  humanReviewItems HumanReviewItem[]
  presentations CasePresentation[]
  reanalysisEvents CaseReanalysisEvent[]
  canonicalState CanonicalCaseState?
  canonicalStateSnapshots CanonicalCaseStateSnapshot[]
  discoveries CaseDiscovery[]
  issueClusters CaseIssueCluster[]
  actionNodes CaseActionNode[]
  evidenceFacts EvidenceFact[]
  events CaseEvent[]
  accountStates AccountPeriodState[]
  evidenceRelationships EvidenceRelationship[]
  evidenceAudits EvidenceAudit[]
  reconstruction CaseReconstruction?
  unknowns CaseUnknown[]
  suppressedQuestions SuppressedQuestion[]
}

// The clarifying-questions conversation: when the analysis lacks specific
// facts (amounts, dates, notice codes), the app interviews the customer and
// feeds every answer back into the analysis automatically.
model CaseClarifyMessage {
  id        String   @id @default(cuid())
  caseId    String
  role      String // assistant | user
  questionKey String @default("") // which targeted question this belongs to
  content   String
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Document {
  id             String    @id @default(cuid())
  userId         String?
  guestSessionId String?
  caseId         String?
  fileName       String
  filePath       String
  mimeType       String    @default("application/octet-stream")
  sizeBytes      Int       @default(0)
  docKind        String    @default("other") // w2 | 1099 | 1040 | notice | transcript | proof | avatar | other
  status         String    @default("uploaded") // uploaded | analyzing | extracted | verification_required
  extractedJson  String    @default("")
  contentHash    String    @default("")
  extractionSchemaVersion String @default("")
  extractorVersionsJson String @default("{}")
  verificationStatus String @default("unverified") // unverified | verified | verification_required
  // v3.2 document inventory: analytical classification and completeness are
  // tracked separately from the customer-selected docKind.
  duplicateOfId  String?
  documentFamily String    @default("")
  documentType   String    @default("") // IRS_ACCOUNT_TRANSCRIPT | IRS_NOTICE | TAX_RETURN | ... | UNKNOWN_TAX_DOCUMENT
  classificationConfidence String @default("") // high | medium | low
  taxPeriodsJson String    @default("[]")
  pagesExpected  Int       @default(0)
  pagesProcessed Int       @default(0)
  tablesDetected Int       @default(0)
  tablesProcessed Int      @default(0)
  transactionRowsDetected Int @default(0)
  transactionRowsExtracted Int @default(0)
  processingStatus String  @default("pending") // pending | complete | partial | failed
  processingNotesJson String @default("[]")
  uploadedAt     DateTime  @default(now())
  deletedAt      DateTime?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  case           Case?         @relation(fields: [caseId], references: [id])
  duplicateOf    Document?     @relation("documentDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     Document[]    @relation("documentDuplicate")
  notices        Notice[]
  fieldVerifications DocumentFieldVerification[]
  evidenceFacts  EvidenceFact[]

  @@index([caseId, contentHash])
}

// ---------- v3.2 evidence intelligence ----------

// Normalized fact compiled from user reports, verified document fields, and
// deterministic calculations. This is the case's evidence ledger.
model EvidenceFact {
  id           String   @id @default(cuid())
  caseId       String
  documentId   String?
  factKey      String // normalized fact identifier, e.g. account_balance
  subject      String   @default("")
  factType     String   @default("") // amount | date | identifier | status | narrative
  valueText    String   @default("")
  valueNumber  Float?
  unit         String   @default("")
  taxPeriod    String   @default("")
  effectiveDate DateTime?
  recordDate   DateTime?
  status       String   @default("active") // active | superseded | disputed
  provenance   String   @default("MODEL_INFERENCE") // USER_REPORTED | DOCUMENT_EXTRACTED | DOCUMENT_VERIFIED | IRS_AUTHORITY | SYSTEM_CALCULATED | PROFESSIONAL_CONFIRMED | MODEL_INFERENCE
  sourceId     String   @default("")
  sourcePage   Int?
  sourceField  String   @default("")
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document     Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([caseId, factKey])
}

// Ordered tax-account events reconstructed from evidence (transcript rows,
// notices, payments). Event types stay open so unknown activity is preserved.
model CaseEvent {
  id              String   @id @default(cuid())
  caseId          String
  taxPeriod       String   @default("")
  eventType       String   @default("UNCLASSIFIED_EVENT")
  transactionCode String   @default("")
  description     String   @default("")
  eventDate       DateTime?
  amount          Float?
  balanceEffect   String   @default("") // increase | decrease | none | unknown
  sourceFactIdsJson String @default("[]")
  provenance      String   @default("DOCUMENT_EXTRACTED")
  createdAt       DateTime @default(now())
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, taxPeriod])
}

// Reconstructed per-period account position.
model AccountPeriodState {
  id                 String   @id @default(cuid())
  caseId             String
  taxPeriod          String
  currentBalance     Float?
  currentBalanceAsOf DateTime?
  currentStatus      String   @default("")
  stateJson          String   @default("{}")
  supportingFactIdsJson String @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, taxPeriod])
}

// Cross-document and cross-period relationships found by the reconciler.
model EvidenceRelationship {
  id               String   @id @default(cuid())
  caseId           String
  relationshipType String
  fromTaxPeriod    String   @default("")
  toTaxPeriod      String   @default("")
  amount           Float?
  status           String   @default("POSSIBLE") // CONFIRMED | POSSIBLE | REJECTED
  description      String   @default("")
  supportingFactIdsJson String @default("[]")
  createdAt        DateTime @default(now())
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, relationshipType])
}

// Result of the evidence audit gate for one analysis cycle.
model EvidenceAudit {
  id                String   @id @default(cuid())
  caseId            String
  analysisVersionId String?
  status            String   @default("EVIDENCE_PROCESSING_INCOMPLETE")
  documentsTotal    Int      @default(0)
  documentsProcessed Int     @default(0)
  documentsVerified Int      @default(0)
  duplicatesResolved Int     @default(0)
  factsCompiled     Int      @default(0)
  unknownsResolved  Int      @default(0)
  unknownsRemaining Int      @default(0)
  reportJson        String   @default("{}")
  createdAt         DateTime @default(now())
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

// Factual reconstruction of the case ahead of tax reasoning.
model CaseReconstruction {
  id                String   @id @default(cuid())
  caseId            String   @unique
  analysisVersionId String?
  reconstructionJson String  @default("{}")
  status            String   @default("draft") // draft | established
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Unknowns tracked explicitly so evidence can close them before the customer
// is ever asked.
model CaseUnknown {
  id               String   @id @default(cuid())
  caseId           String
  unknownKey       String
  label            String
  question         String   @default("")
  reason           String   @default("")
  materiality      String   @default("medium") // low | medium | high
  status           String   @default("ACTIVE") // ACTIVE | RESOLVED_BY_EXISTING_EVIDENCE | RESOLVED_BY_CUSTOMER | NOT_MATERIAL
  resolvedValue    String   @default("")
  supportingFactIdsJson String @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, unknownKey])
}

// Audit trail for questions the app decided not to ask because evidence
// already answered them.
model SuppressedQuestion {
  id            String   @id @default(cuid())
  caseId        String
  questionKey   String
  question      String   @default("")
  missingFact   String   @default("")
  reason        String   @default("")
  supportingFactIdsJson String @default("[]")
  createdAt     DateTime @default(now())
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, questionKey])
}

model CaseAnalysisVersion {
  id             String   @id @default(cuid())
  caseId         String
  version        Int
  status         String   @default("running") // running | approved | needs_verification | human_review | failed
  trigger        String   @default("analysis")
  snapshotJson   String   @default("{}")
  sourceSnapshotIdsJson String @default("[]")
  issueIdsJson   String   @default("[]")
  pathStepIdsJson String  @default("[]")
  createdAt      DateTime @default(now())
  approvedAt     DateTime?
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  presentations  CasePresentation[]
  fieldVerifications DocumentFieldVerification[]
  humanReviewItems HumanReviewItem[]

  @@unique([caseId, version])
}

model CanonicalCaseState {
  id          String   @id @default(cuid())
  caseId      String   @unique
  version     Int      @default(1)
  stateJson   String   @default("{}")
  stateHash   String   @default("")
  status      String   @default("current")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CanonicalCaseStateSnapshot {
  id        String   @id @default(cuid())
  caseId    String
  version   Int
  trigger   String   @default("analysis")
  stateJson String   @default("{}")
  stateHash String   @default("")
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
}

model CaseDiscovery {
  id            String   @id @default(cuid())
  caseId        String
  caseVersion   Int
  discoveryJson String   @default("{}")
  createdAt     DateTime @default(now())
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, caseVersion])
}

model CaseIssueCluster {
  id               String   @id @default(cuid())
  caseId           String
  analysisVersionId String?
  clusterKey       String
  title            String
  category         String   @default("UNCLASSIFIED_TAX_ISSUE")
  status           String   @default("NEEDS_VERIFICATION")
  evidenceStrength String   @default("LIMITED")
  issueIdsJson     String   @default("[]")
  unknownsJson     String   @default("[]")
  possibleExplanationsJson String @default("[]")
  actionsJson      String   @default("[]")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseActionNode {
  id          String   @id @default(cuid())
  caseId      String
  actionKey   String
  normalizedPurpose String
  title       String
  description String @default("")
  priority    Int    @default(1)
  dependsOnJson String @default("[]")
  resolvesJson String @default("[]")
  requiresJson String @default("[]")
  status      String @default("READY")
  createdAt   DateTime @default(now())
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model SourceSnapshot {
  id             String   @id @default(cuid())
  snapshotHash   String   @unique
  sourceRefsJson String   @default("[]")
  taxYearsJson   String   @default("[]")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
}

model AnalysisRun {
  id         String    @id @default(cuid())
  caseId     String?
  stageKey   String
  status     String    @default("pending") // pending | running | complete | failed
  error      String    @default("")
  caseAnalysisVersion Int @default(1)
  pipelineVersion String @default("")
  schemaVersion String @default("")
  sourceSnapshotId String @default("")
  metadataJson String @default("{}")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  case       Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stepResults AnalysisStepResult[]
  consensus  ConsensusResult?
}

model DocumentFieldVerification {
  id                String   @id @default(cuid())
  documentId        String
  caseId            String?
  analysisVersionId String?
  fieldKey          String
  fieldValue        String   @default("")
  status            String   @default("candidate") // candidate | verified | verification_required | rejected
  sourcesJson       String   @default("[]")
  locationJson      String   @default("{}")
  createdAt         DateTime @default(now())
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  analysisVersion   CaseAnalysisVersion? @relation(fields: [analysisVersionId], references: [id], onDelete: SetNull)
}

model HumanReviewItem {
  id                String   @id @default(cuid())
  caseId            String
  analysisVersionId String?
  reason            String
  severity          String   @default("medium") // low | medium | high | urgent
  status            String   @default("open") // open | assigned | resolved | dismissed
  payloadJson       String   @default("{}")
  createdAt         DateTime @default(now())
  resolvedAt        DateTime?
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  analysisVersion   CaseAnalysisVersion? @relation(fields: [analysisVersionId], references: [id], onDelete: SetNull)
}

model CasePresentation {
  id                String   @id @default(cuid())
  caseId            String
  analysisVersionId String?
  schemaVersion     String   @default("3.0")
  presentationJson  String   @default("{}")
  createdAt         DateTime @default(now())
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  analysisVersion   CaseAnalysisVersion? @relation(fields: [analysisVersionId], references: [id], onDelete: SetNull)
}

model CaseReanalysisEvent {
  id            String   @id @default(cuid())
  caseId        String
  trigger       String
  pipelinesJson String  @default("[]")
  idempotencyKey String?
  status        String  @default("queued") // queued | running | complete | failed
  actorType     String  @default("system")
  metadataJson  String  @default("{}")
  createdAt     DateTime @default(now())
  finishedAt    DateTime?
  case          Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model AnalysisStepResult {
  id         String      @id @default(cuid())
  runId      String
  providerId String?
  roleKey    String
  status     String      @default("pending") // pending | complete | failed
  rawText    String      @default("")
  parsedJson String      @default("")
  latencyMs  Int         @default(0)
  promptId   String      @default("")
  promptVersion String   @default("")
  schemaVersion String   @default("")
  providerRoute String   @default("")
  modelRoute String      @default("")
  qualityGate String     @default("")
  errorCode String       @default("")
  inputTokens Int        @default(0)
  outputTokens Int       @default(0)
  estimatedCostMicros Int @default(0)
  run        AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider   AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
}

model ConsensusResult {
  id                   String      @id @default(cuid())
  runId                String      @unique
  mergedJson           String      @default("")
  conflictsJson        String      @default("[]")
  verificationRequired Boolean     @default(false)
  run                  AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Issue {
  id             String  @id @default(cuid())
  caseId         String
  issueType      String  @default("general") // refund_discrepancy | balance_due | missing_return | notice_response | penalty | other
  taxYear        Int?
  title          String
  description    String  @default("")
  expectedCents  Int?
  receivedCents  Int?
  differenceCents Int?
  confidence     String  @default("medium") // high | medium | low
  priority       String  @default("medium") // urgent | high | medium | low
  state          String  @default("review") // resolved | review | action_needed | urgent | info_needed
  nextAction     String  @default("")
  irsBasis       String  @default("")
  evidenceJson   String  @default("[]")
  // Evidence-based product taxonomy (never AI confidence percentages).
  itemKind         String @default("issue") // finding | issue | opportunity | risk | missing_info
  evidenceStatus   String @default("needs_verification") // confirmed | likely | possible | needs_verification | not_supported
  evidenceStrength String @default("limited") // strong | moderate | limited
  conclusion       String @default("") // "Our conclusion" — what the pieces indicate together
  unclearJson      String @default("[]") // specific unresolved questions (string[])
  explanationsJson String @default("[]") // most likely explanations [{title, detail, likelihood}]
  altAction        String @default("") // alternative to the recommended next step
  createdAt      DateTime @default(now())
  case           Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Case discussion: customers, consultants, and admins comment on a case with
// visibility controls (which checkboxes are available is admin-configurable).
model CaseComment {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String
  authorRole String // customer | consultant | admin
  body       String
  visibility String   @default("all") // all | hidden_from_customer | private
  attachmentsJson String @default("[]") // Document ids attached to this comment
  createdAt  DateTime @default(now())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model PathStep {
  id          String @id @default(cuid())
  caseId      String
  sortOrder   Int    @default(0)
  title       String
  description String @default("")
  actionKey   String @default("")
  status      String @default("pending") // pending | current | done
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// ---------- Notices, deadlines, letters ----------

model Notice {
  id            String    @id @default(cuid())
  userId        String?
  caseId        String?
  documentId    String?
  noticeType    String    @default("") // CP2000, CP14, LT11 ...
  taxYear       Int?
  amountCents   Int?
  deadline      DateTime?
  explanation   String    @default("")
  nextStepsJson String    @default("[]")
  status        String    @default("uploaded") // uploaded | analyzing | explained | verification_required
  createdAt     DateTime  @default(now())
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case          Case?     @relation(fields: [caseId], references: [id])
  document      Document? @relation(fields: [documentId], references: [id])
  letters       ResponseLetter[]
}

model Deadline {
  id               String    @id @default(cuid())
  userId           String
  caseId           String?
  title            String
  dueDate          DateTime
  source           String    @default("manual") // manual | notice | analysis
  status           String    @default("open") // open | done | missed
  remindDaysBefore Int       @default(7)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case             Case?     @relation(fields: [caseId], references: [id])
}

model ResponseLetter {
  id        String   @id @default(cuid())
  userId    String
  caseId    String?
  noticeId  String?
  title     String
  body      String   @default("")
  status    String   @default("draft") // draft | final
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case      Case?    @relation(fields: [caseId], references: [id])
  notice    Notice?  @relation(fields: [noticeId], references: [id])
}

// ---------- Q&A ----------

model QaThread {
  id             String       @id @default(cuid())
  userId         String?
  guestSessionId String?
  title          String       @default("Tax question")
  kind           String       @default("qa") // qa | guide
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  messages       QaMessage[]
}

model QaMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
  thread    QaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

// ---------- IRS forms (game-like wizard) ----------

model IrsFormTemplate {
  id             String           @id @default(cuid())
  formNumber     String // "1040", "W-4", "9465"...
  title          String
  description    String           @default("")
  category       String           @default("individual")
  stepsJson      String           @default("[]") // wizard step/question definitions
  outputTemplate String           @default("") // text template regenerated into standard form layout
  // Official IRS PDF infusion: the app downloads the real IRS PDF and fills
  // its AcroForm fields with the customer's wizard answers.
  pdfSourceUrl   String           @default("") // e.g. https://www.irs.gov/pub/irs-pdf/f9465.pdf
  pdfPath        String           @default("") // cached copy in the uploads store
  pdfMapJson     String           @default("[]") // [{field, source|expr|const, transform?, checkIf?}]
  isPublished    Boolean          @default(false)
  requiredFeature String          @default("") // feature key gating access, empty = free
  sortOrder      Int              @default(0)
  updatedAt      DateTime         @updatedAt
  submissions    FormSubmission[]
}

model FormSubmission {
  id            String          @id @default(cuid())
  userId        String
  templateId    String
  dataJson      String          @default("{}")
  progressPct   Int             @default(0)
  status        String          @default("in_progress") // in_progress | completed
  generatedText String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      IrsFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// ---------- Consultants ----------

model ConsultantProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  credentialType     String    @default("tax_consultant") // cpa | ea | tax_consultant
  credentialNumber   String    @default("")
  licenseState       String    @default("")
  ptin               String    @default("")
  efin               String    @default("")
  proofDocumentPath  String    @default("")
  photoIdPath        String    @default("")
  insurancePath      String    @default("")
  attestedCompliance Boolean   @default(false)
  isBusiness         Boolean   @default(false)
  businessName       String    @default("")
  ein                String    @default("")
  specialties        String    @default("[]") // JSON array of specialty keys
  statesServed       String    @default("")
  yearsExperience    Int       @default(0)
  status             String    @default("pending") // pending | approved | rejected | suspended
  autoApproved       Boolean   @default(false)
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String    @default("")
  experiences        String    @default("") // free-text list of experience areas, one per line
  languages          String    @default("") // e.g. "English, Spanish"
  website            String    @default("")
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pastCases          ConsultantPastCase[]
}

// Past cases a consultant has handled — used by the AI matching engine when
// auto-assigning consultants to customers.
model ConsultantPastCase {
  id           String            @id @default(cuid())
  profileId    String
  title        String
  category     String            @default("other") // matches issue types / specialties
  description  String            @default("")
  year         Int?
  outcome      String            @default("")
  createdAt    DateTime          @default(now())
  profile      ConsultantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ---------- Support tickets (standalone) ----------

model Ticket {
  id           String   @id @default(cuid())
  number       Int      @unique @default(autoincrement()) // human-friendly ticket number (TKT-000001)
  userId       String
  subject      String
  category     String   @default("customer_service") // customer_service | tech_support
  status       String   @default("open") // open | in_progress | resolved | closed
  priority     String   @default("normal") // low | normal | high | urgent
  source       String   @default("manual") // manual | chatbot | admin | email
  assignedToId String? // staff agent handling this ticket
  firstResponseAt DateTime? // first public staff reply (SLA tracking)
  resolvedAt   DateTime?
  closedAt     DateTime?
  csatRating   Int? // 1–5 customer satisfaction after resolution
  csatComment  String   @default("")
  csatAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?    @relation("ticketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  attachments  TicketAttachment[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String   @default("")
  fromStaff Boolean  @default(false)
  internal  Boolean  @default(false) // staff-only note or system audit entry — never shown to the user
  system    Boolean  @default(false) // automated audit entry (status/routing/assignment changes)
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments TicketAttachment[]
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  messageId String?
  fileName  String
  filePath  String
  mimeType  String   @default("application/octet-stream")
  sizeBytes Int      @default(0)
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

// ---------- System messages (customer communication) ----------

// Every message the platform sends to customers/consultants — editable HTML
// templates. Event templates fire on activity (account created, password
// reset, subscription confirmed); scheduled templates fire relative to
// subscription expiration (offsetDays: -7, -3, 0, +7); custom templates are
// pushed manually by admins.
model MessageTemplate {
  key        String   @id
  name       String
  subject    String
  bodyHtml   String   @default("")
  kind       String   @default("event") // event | scheduled | custom
  offsetDays Int? // for scheduled: days relative to subscription expiration (negative = before)
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  logs       MessageLog[]
}

model MessageLog {
  id          String          @id @default(cuid())
  templateKey String
  userId      String
  dedupeKey   String?         @unique // prevents duplicate scheduled sends
  emailSent   Boolean         @default(false)
  sentAt      DateTime        @default(now())
  template    MessageTemplate @relation(fields: [templateKey], references: [key], onDelete: Cascade)
}

// Saved reply templates for support agents.
model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("all") // all | customer_service | tech_support
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultantAssignment {
  id                 String    @id @default(cuid())
  consultantId       String
  userId             String
  caseId             String?
  status             String    @default("proposed") // proposed | user_accepted | active | declined | revoked
  note               String    @default("")
  autoAssigned       Boolean   @default(false)
  reasonSummary      String    @default("") // one-line AI recommendation reason
  reasonDetail       String    @default("") // detailed outlined reason
  assignedById       String    @default("")
  userAgreedAt       DateTime?
  consultantAgreedAt DateTime?
  createdAt          DateTime  @default(now())
  consultant         User      @relation("assignmentConsultant", fields: [consultantId], references: [id], onDelete: Cascade)
  user               User      @relation("assignmentClient", fields: [userId], references: [id], onDelete: Cascade)
  case               Case?     @relation(fields: [caseId], references: [id])
}

// ---------- System log (failures & operational events) ----------

model SystemLog {
  id         String   @id @default(cuid())
  level      String   @default("error") // error | warning | info
  source     String   @default("system") // ai_call | analysis | email | payment | webhook | inbound_email | guide | matching | cron
  message    String
  detail     String   @default("")
  userId     String   @default("")
  createdAt  DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
}

// ---------- Notifications ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    @default("info") // info | consultant_needed | assignment | deadline | billing
  title     String
  body      String    @default("")
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
